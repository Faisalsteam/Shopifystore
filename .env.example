# Copy to .env and fill in real values locally. Never commit .env.
# This file only documents which credentials each integration needs —
# see docs/integrations.md for what each one is for and its status.

# Shopify
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Payment gateway (pick one based on launch country — see docs/integrations.md)
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

# Klaviyo
KLAVIYO_API_KEY=
KLAVIYO_PUBLIC_API_KEY=

# WhatsApp Business API / BSP (Zoko or WATI)
WHATSAPP_BSP_PROVIDER=
WHATSAPP_BSP_API_KEY=
META_BUSINESS_MANAGER_ID=

# Courier (Aramex / iMile / local courier — TBD)
COURIER_PROVIDER=
COURIER_API_KEY=

# Google Maps (deferred — only needed for future in-house delivery app)
GOOGLE_MAPS_API_KEY=

# Competitive monitoring (Prisync or similar)
PRISYNC_API_KEY=
