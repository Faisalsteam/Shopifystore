{%- comment -%}
  Floating WhatsApp click-to-chat button.

  Needs no WhatsApp Business API / BSP account — this is a plain wa.me
  link (https://faq.whatsapp.com/general/chats/how-to-use-click-to-chat),
  which works with any WhatsApp number. The Business API + BSP integration
  (Zoko/WATI, automated flows) is a separate, later Phase 4 item — see
  docs/roadmap.md — this just gets a "message us" entry point live now.

  Rendered directly in theme.liquid (not a header/footer group section) so
  it floats on every page, same pattern Dawn uses for the cart drawer.
{%- endcomment -%}

{%- if section.settings.enable and section.settings.phone != blank -%}
  {%- assign wa_digits = section.settings.phone
    | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  -%}
  {%- style -%}
    .whatsapp-button {
      --whatsapp-button-background: {{ section.settings.background_color }};
      --whatsapp-button-icon-color: {{ section.settings.icon_color }};
    }
  {%- endstyle -%}
  <a
    href="https://wa.me/{{ wa_digits }}?text={{ section.settings.default_message | url_encode }}"
    class="whatsapp-button"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="whatsapp-button__label">{{ section.settings.label | default: 'Chat with us on WhatsApp' }}</span>
    <svg class="whatsapp-button__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path d="M16 3C9.1 3 3.5 8.6 3.5 15.5c0 2.5.7 4.8 2 6.8L3 29l6.9-2.4c1.9 1.1 4.1 1.7 6.1 1.7 6.9 0 12.5-5.6 12.5-12.5S22.9 3 16 3zm0 22.7c-1.9 0-3.7-.5-5.3-1.5l-.4-.2-4.1 1.4 1.4-4-.2-.4c-1.1-1.7-1.7-3.7-1.7-5.7 0-5.9 4.8-10.7 10.7-10.7s10.7 4.8 10.7 10.7S21.9 25.7 16 25.7z"/>
      <path d="M21.6 18.4c-.3-.2-1.9-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-2-1.8-2.3-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1.1 2.8 1.2 3c.1.2 2.1 3.3 5.2 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.9-.8 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.1-.3-.2-.6-.3z"/>
    </svg>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "WhatsApp button",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Show WhatsApp button",
      "default": true
    },
    {
      "type": "text",
      "id": "phone",
      "label": "WhatsApp number",
      "info": "Include country code, no + sign or spaces needed (e.g. 96555512345 for Kuwait). Leave blank to hide the button."
    },
    {
      "type": "text",
      "id": "default_message",
      "label": "Pre-filled message",
      "default": "Hi! I have a question about a product."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Accessibility label",
      "default": "Chat with us on WhatsApp",
      "info": "Read by screen readers; not shown on screen."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Button color",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "WhatsApp button"
    }
  ]
}
{% endschema %}
